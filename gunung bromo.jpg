    <body>

        <div class="sticky-share has-class" style="z-index: 10;">
    <div class="sticky-share__wrap">
        <div class="sticky-share__ar-title">10 Obyek Wisata Gunung Bromo, Kapan Kamu Mau ke Sini?</div>
        <div class="flex-between">
                        <social-actions id="social-actions" comment-count="902" comment-href="#comm1" liked="">
                <style>
                    /* @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap'); */

                    #social-actions {
                        --sa-font:    'Montserrat', 'Montserrat-FF', system-ui, sans-serif;
                        --sa-color:   #323232;
                        --sa-active:  #2C5498;
                        --sa-hover:   #f5f5f5;
                        display: inline-block;
                        width: 100%;
                    }
                    social-actions>*, social-actions>*::before, social-actions>*::after { box-sizing: border-box; }

                    .sa-actions {
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        gap: 2px;
                        width: 100%;    
                    }

                    /* The default buttons rendered by this component */
                    .sa-btn {
                        display: inline-flex;
                        align-items: center;
                        gap: 6px;
                        background: none;
                        border: none;
                        cursor: pointer;
                        color: var(--sa-color);
                        font-family: var(--sa-font);
                        font-size: 12px;
                        padding: 6px 8px;
                        border-radius: 10px;
                        text-decoration: none;
                        transition: background 0.15s, color 0.15s;
                    }
                    .sa-btn:hover { background: var(--sa-hover); }
                    .sa-btn.liked, .sa-btn.bookmarked { color: var(--sa-active); }

                    .sa-count { font-weight: 400; color: inherit; line-height: 1; }
                    .sa-icon  { display: block; }

                    /* Outline shows by default, filled shows when pressed */
                    .sa-icon--filled { display: none; }
                    .sa-btn.liked .sa-icon--outline, .sa-btn.bookmarked .sa-icon--outline { display: none; }
                    .sa-btn.liked .sa-icon--filled, .sa-btn.bookmarked .sa-icon--filled { display: block; }

                    /* Custom slotted buttons sit on the same baseline */
                    ::slotted(*) { cursor: pointer; }

                    ::slotted([slot="extra"]),
                    .sa-preferred {
                        display: inline-flex;
                        align-items: center;
                        line-height: 0;
                    }

                    /* ── Share tooltip (desktop) ──────────────────────────────── */
                    .sa-share-wrap { position: relative; display: inline-flex; }

                    .sa-share-tooltip {
                        position: absolute;
                        top: calc(100% + 8px);
                        right: 0;
                        z-index: 10;
                        border: 1px solid #f3f4f6;
                        border-radius: 8px;
                        background: #fff;
                        box-shadow: 0 1.545px 30px rgba(0, 0, 0, 0.20);
                        opacity: 0;
                        pointer-events: none;
                        transition: opacity 0.15s ease;
                    }
                    .sa-share-tooltip[aria-expanded="true"] {
                        opacity: 1;
                        pointer-events: auto;
                    }

                    .sa-share-arrow {
                        position: absolute;
                        top: -6px;
                        right: 12px;
                        width: 11px;
                        height: 11px;
                        background: #fff;
                        border-left: 1px solid #f3f4f6;
                        border-top: 1px solid #f3f4f6;
                        transform: rotate(45deg);
                    }

                    .sa-share-box {
                        display: flex;
                        gap: 14px;
                        padding: 12px 20px;
                    }

                    /* Each slotted share link/button renders as a round icon button */
                    [slot="share"]{
                        display: inline-flex;
                        align-items: center;
                        justify-content: center;
                        width: 32px;
                        height: 32px;
                        padding: 0;
                        border: none;
                        border-radius: 9999px;
                        background: #f3f4f6;
                        cursor: pointer;
                    }

                </style>    
                <div class="sa-actions" part="actions">

                <!-- Like — overridable via slot="like" -->
                
                    <button class="sa-btn" type="button"
                        data-button="like"
                        onclick="liked.click(this);"
