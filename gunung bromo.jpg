  <script type="text/javascript">
    let sneekPeek = null;
    let fetchSneakPeek = async () => {
        const response = await fetch(
            "https://apicomment.detik.com/detail-article/sneak-peek/?article_id=4459003&channel_id=1519&site=dtk",
            {
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                }
            }
        );

        const json = await response.json();
        if (json.status) {
            sneakPeek = json.data;
        }
    }

    fetchSneakPeek();

    let getSneakPeek = () => sneakPeek;
    document.addEventListener('DOMContentLoaded', (event) => {
        if (typeof dFramebar !== 'undefined' && typeof window.onLoginClientCallback !== 'undefined') {
            window.onLoginClientCallback.push(async function (auth) {
                const { total_comment } = await getSneakPeek();
                document.querySelectorAll('[data-itp-comcount')
                .forEach((item) => {
                    item.textContent = total_comment;
                });
            });
        }

    });

    var initedComment = false;
    $(window).on('scroll', function() {

      if (initedComment) { return; }
      if ($(window).scrollTop() <= 300) { return; }
      if (parseInt($('.comment-count:first').text()) <= 0) { return; }
      
      initedComment = true;
      getScript("https://cdn.detik.net.id/libs/comment/v2/js/zoid.min.js?2026090709", function(){
        getScript("https://cdn.detik.net.id/libs/comment/v2/js/bridge.js?2026090709", function(){
          $('#thecomment2').html('');
          CommentComponent({
            url: "https://travel.detik.com/domestic-destination/d-4459003/10-obyek-wisata-gunung-bromo-kapan-kamu-mau-ke-sini",
            idArtikel: 4459003,
            kanal: 1519,
