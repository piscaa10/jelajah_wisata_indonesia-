                <style>
.wrap-toast {
    position: fixed;
    bottom: 24px;
    left: unset !important;
    right: 24px;
    z-index: 999999;
    width: unset !important;

    display: flex;
    flex-direction: column-reverse;
    gap: 10px;

    pointer-events: none;
}

.toast {
    display: flex;
    align-items: center;
    gap: 12px;

    min-width: 280px;
    max-width: 360px;

    /* collapsed state */
    max-height: 0;
    padding: 0 14px;          /* keep horizontal padding only */
    margin: 0;
    overflow: hidden;

    background: #2C5298;
    border-radius: 10px;
    color: #fff;

    box-shadow:
        0 12px 32px rgba(0,0,0,.22),
        0 3px 8px rgba(0,0,0,.14);

    transform: translateX(120%);
    opacity: 0;

    transition:
        max-height .35s ease,
        padding .35s ease,
        transform .36s cubic-bezier(.2,.85,.2,1),
        opacity .22s ease;

    pointer-events: auto;
    will-change: transform, opacity, max-height;
}

.toast.show {
    max-height: 120px;      /* larger than actual toast height */
    padding: 10px 14px;
    transform: translateX(0);
    opacity: 1;
}

.toast.hide {
    max-height: 0;
    padding: 0 14px;
    transform: translateX(120%);
    opacity: 0;
}
.toast p    {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.35;
    letter-spacing: 0.1px;
    flex: 1;
}

.toast button {
    background: none;
    border: none;
    display: flex;
}
</style>

