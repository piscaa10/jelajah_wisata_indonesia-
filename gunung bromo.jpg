<script>
class CbRekomenditDesktop extends HTMLElement {
 static css = /*css*/ `
 :host {
 display: block;
 max-width: 100%;
 }
 a:not([href]):not([class]),
 a:not([href]):not([class]):hover {
 color: inherit;
 }
 *,::after,::before{box-sizing:border-box}*{margin:0}@media (prefers-reduced-motion:no-preference){html{interpolate-size:allow-keywords}}body{line-height:1.5;-webkit-font-smoothing:antialiased}canvas,img,picture,svg,video{display:block;max-width:100%}button,input,select,textarea{font:inherit}h1,h2,h3,h4,h5,h6,p{overflow-wrap:break-word}p{text-wrap:pretty}h1,h2,h3,h4,h5,h6{text-wrap:balance}#__next,#root{isolation:isolate}
 
 .cb-rekomendit {
 background: #F7F7F7;
 border-radius: 8px;
 padding: 20px 24px;
 display: flex;
 flex-direction: column;
 gap: 16px;
 font-family: 'Montserrat', 'Montserrat-FF', sans-serif;
 font-size: 14px;
 margin-bottom: 24px;
 }
 /* Header Section */
 .cb-rekomendit__header {
 display: flex;
 flex-direction: column;
 align-items: center;
 gap: 4px;
 position: relative;
 }
 .cb-rekomendit__logo {
 display: flex;
 align-items: center;
 gap: 6px;
 text-decoration: none;
 }
 .cb-rekomendit__logo img{
 width: 162px;
 height: auto;
 }
 .cb-rekomendit__subtitle {
 padding-top: 8px;
 font-size: 14px;
 font-weight: 500;
 color: #666;
 text-align: center;
 }
 .cb-rekomendit__cta-btn {
 position: absolute;
 right: 0;
 top: 0;
 background: rgba(247, 239, 138, 0.16);
 border: 1px solid #E5B771;
 border-radius: 6px;
 padding: 8px 16px;
 font-size: 13px;
 font-weight: 500;
 color: #232323;
 text-decoration: none;
 display: flex;
 align-items: center;
 gap: 6px;
 transition: all 0.2s ease;
 }
 .cb-rekomendit__cta-btn:hover {
 background: rgba(247, 239, 138, 0.5);
 border-color: #E5B771;
 }
 .cb-rekomendit__cta-btn svg {
 width: 14px;
 height: 14px;
 }
 /* Grid Layout */
 .cb-rekomendit__grid {
 display: grid;
 grid-template-columns: repeat(2, 1fr);
 gap: 20px;
 }
 /* Item Card */
 .cb-rekomendit__item {
 display: flex;
 flex-direction: row;
 gap: 12px;
 background: transparent;
 border-radius: 8px;
 transition: transform 0.2s ease;
 position: relative;
 }
 .cb-rekomendit__item-link {
 position: absolute;
 top: 0;
 left: 0;
 width: 100%;
 height: 100%;
 z-index: 1;
 }
 .cb-rekomendit__item-image {
 width: 136px;
 aspect-ratio: 4 / 3;
 flex-shrink: 0;
 overflow: hidden;
 position: relative;
 }
 .cb-rekomendit__item-image img {
 width: 100%;
 height: 100%;
 object-fit: cover;
 display: block;
 transition: transform 0.4s ease;
 }
 .cb-rekomendit__item:hover .cb-rekomendit__item-image img {
 transform: scale(1.1);
 }
 .cb-rekomendit__share-btn {
 position: absolute;
 top: 8px;
 right: 8px;
 background: rgba(255, 255, 255, 0.7);
 border: none;
 cursor: pointer;
 border-radius: 50%;
 width: 26px;
 height: 26px;
 padding: 6px;
 display: flex;
 align-items: center;
 justify-content: center;
 z-index: 2;
 transition: all 0.2s ease;
 }
 .cb-rekomendit__share-btn:hover {
 background: rgba(255, 255, 255, 0.9);
 transform: scale(1.15);
 }
 .cb-rekomendit__share-btn img {
 width: 100%;
 height: auto;
 object-fit: contain;
 }
 .cb-rekomendit__item-content {
 display: flex;
 flex-direction: column;
 gap: 6px;
 padding-top: 8px;
 }
 .cb-rekomendit__item-category {
 font-size: 12px;
 font-weight: 400;
 line-height: 17px;
 letter-spacing: 0.48px;
 color: #C58524;
 }
 .cb-rekomendit__item-title {;
 font-style: normal;
 font-size: 14px;
 font-weight: 500;
 line-height: 20px;
 color: #232323;
 overflow: hidden;
 display: -webkit-box;
 -webkit-box-orient: vertical;
 -webkit-line-clamp: 3;
 }
`;
 static html = /*html*/ `
